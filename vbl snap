local function selectPage(pageName)
	local showVbl = pageName == "VBL"
	vblPage.Visible = showVbl
	settingsPage.Visible = not showVbl
	vblMarker.Visible = showVbl
	settingsMarker.Visible = not showVbl
	vblButton.TextColor3 = showVbl and colors.text or colors.muted
	settingsButton.TextColor3 = showVbl and colors.muted or colors.text
	modeOptions.Visible = false
end


local Config = {
	path = "VBLJumpRotation_" .. player.UserId .. ".json",
	cacheKey = "VBLJumpRotationConfig_" .. player.UserId,
	values = table.clone(ConfigDefaults), pending = nil,
}
local savedConfig = environment[Config.cacheKey]

if readfile and isfile then
	local ok, result = pcall(function()
		if isfile(Config.path) then return HttpService:JSONDecode(readfile(Config.path)) end
	end)
	if ok then
		if result ~= nil then savedConfig = result end
	else
		warn("[VBL] Could not load config: " .. tostring(result))
	end
end

if type(savedConfig) == "table" then
	if savedConfig.ReceiveSize == nil and type(savedConfig.ReceiveWidth) == "number" then
		Config.values.ReceiveSize = savedConfig.ReceiveWidth
	end
	for key, default in pairs(ConfigDefaults) do
		local value = savedConfig[key]
		if type(value) == type(default) then Config.values[key] = value end
	end
end

local KeyCodes = {}
for _, code in ipairs(Enum.KeyCode:GetEnumItems()) do KeyCodes[code.Name] = code end
for key, default in pairs(ConfigDefaults) do
	if key:match("Key$") and (not KeyCodes[Config.values[key]] or Config.values[key] == "Unknown" or Config.values[key] == "Escape") then
		Config.values[key] = default
	end
end
if Config.values.RotationMode ~= "Snap" and Config.values.RotationMode ~= "Smooth" and Config.values.RotationMode ~= "Custom" then
	Config.values.RotationMode = "Snap"
end
local savedSpeed = Config.values.CustomTurnSpeed
Config.values.CustomTurnSpeed = savedSpeed == savedSpeed and math.clamp(math.round(savedSpeed), 1, 30) or 16
local savedReceiveDelay = Config.values.ReceiveDelayMs
Config.values.ReceiveDelayMs = savedReceiveDelay == savedReceiveDelay and math.clamp(math.round(savedReceiveDelay), 25, 250) or 50

function Config:Flush()
	if self.pending then
		task.cancel(self.pending)
		self.pending = nil
	end
	self.values = self.capture()
	environment[self.cacheKey] = self.values
	if not writefile then
		if not self.writeWarning then
			self.writeWarning = true
			warn("[VBL] No writefile support; config will only be kept for this session.")
		end
		return
	end
	local ok, message = pcall(function()
		writefile(self.path, HttpService:JSONEncode(self.values))
	end)
	if not ok and not self.writeWarning then
		self.writeWarning = true
		warn("[VBL] Could not save config: " .. tostring(message))
	end
end

function Config:Queue()
	if not alive or self.pending then return end
	self.pending = task.delay(0.25, function()
		self.pending = nil
		self:Flush()
	end)
end


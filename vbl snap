-- Menu settings
local jumpRotationEnabled = true
local rotationMode = "Snap" -- "Snap" or "Smooth"
local menuOpen = true
local menuToggleKey = Enum.KeyCode.F1
local menuKeyCapture = false
local JUMP_COOLDOWN = 0.18
local SNAP_YAW_SPEED = math.rad(1200) -- constant turn speed for consistent snaps
local SMOOTH_TURN_TIME = 0.32

local humanoid
local rootPart
local lastJumpTime = 0

local rotationLockHumanoid
local rotationLockAutoRotate
local rotationStateConnection
local rotationLockId = 0
local smoothTurnConnection

local function cancelSmoothTurn()
	if smoothTurnConnection then
		smoothTurnConnection:Disconnect()
		smoothTurnConnection = nil
	end
end

local function releaseRotationLock()
	rotationLockId += 1

	if rotationStateConnection then
		rotationStateConnection:Disconnect()
		rotationStateConnection = nil
	end

	local oldHumanoid = rotationLockHumanoid
	local oldAutoRotate = rotationLockAutoRotate
	rotationLockHumanoid = nil
	rotationLockAutoRotate = nil

	if oldHumanoid and oldHumanoid.Parent and oldAutoRotate ~= nil then
		oldHumanoid.AutoRotate = oldAutoRotate
	end
end

local function bindCharacter(character)
	releaseRotationLock()
	cancelSmoothTurn()

	humanoid = character:WaitForChild("Humanoid")
	rootPart = character:WaitForChild("HumanoidRootPart")
end

player.CharacterAdded:Connect(bindCharacter)
if player.Character then
	bindCharacter(player.Character)
end

local function getAimFacingCFrame(root)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	local aimDirection
	if UserInputService.MouseEnabled then
		-- Aim through the actual mouse position. Raycast ignores the local
		-- character so the ray can find the point under the cursor.
		local mousePosition = UserInputService:GetMouseLocation()
		local aimRay = camera:ScreenPointToRay(mousePosition.X, mousePosition.Y)
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = player.Character and { player.Character } or {}
		raycastParams.IgnoreWater = true

		local hit = workspace:Raycast(aimRay.Origin, aimRay.Direction * 1200, raycastParams)
		local aimPoint = hit and hit.Position or (aimRay.Origin + aimRay.Direction * 1200)
		aimDirection = aimPoint - root.Position
	else
		-- Controller/touch fallback: use the camera's center look.
		aimDirection = camera.CFrame.LookVector
	end

	-- Characters rotate on the ground plane, so discard the vertical component.
	local flatAim = Vector3.new(aimDirection.X, 0, aimDirection.Z)
	if flatAim.Magnitude < 0.001 then
		local cameraLook = camera.CFrame.LookVector
		flatAim = Vector3.new(cameraLook.X, 0, cameraLook.Z)
	end
	if flatAim.Magnitude < 0.001 then
		local rootLook = root.CFrame.LookVector
		flatAim = Vector3.new(rootLook.X, 0, rootLook.Z)
	end
	if flatAim.Magnitude < 0.001 then
		return nil
	end

	return CFrame.lookAt(root.Position, root.Position + flatAim.Unit)
end

local function turnToTarget(root, targetCFrame)
	cancelSmoothTurn()

	local snapMode = rotationMode == "Snap"
	local startRotation = root.CFrame.Rotation
	local targetRotation = targetCFrame.Rotation
	local startedAt = os.clock()
	local startYaw
	local yawDelta
	local duration

	if snapMode then
		-- Scale duration to the angle, so small and large turns use the same
		-- angular speed instead of feeling randomly fast or slow.
		local startLook = root.CFrame.LookVector
		local targetLook = targetCFrame.LookVector
		startYaw = math.atan2(-startLook.X, -startLook.Z)
		local targetYaw = math.atan2(-targetLook.X, -targetLook.Z)
		yawDelta = math.atan2(math.sin(targetYaw - startYaw), math.cos(targetYaw - startYaw))
		duration = math.abs(yawDelta) / SNAP_YAW_SPEED
	else
		duration = SMOOTH_TURN_TIME
	end

	if duration < 1 / 120 then
		root.CFrame = CFrame.new(root.Position) * targetRotation
		return
	end

	smoothTurnConnection = RunService.Heartbeat:Connect(function()
		if not root.Parent then
			cancelSmoothTurn()
			return
		end

		local alpha = math.clamp((os.clock() - startedAt) / duration, 0, 1)
		local easedAlpha = alpha * alpha * (3 - 2 * alpha)
		if snapMode then
			local yaw = startYaw + yawDelta * easedAlpha
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
		else
			root.CFrame = CFrame.new(root.Position) * startRotation:Lerp(targetRotation, easedAlpha)
		end

		if alpha >= 1 then
			root.CFrame = CFrame.new(root.Position) * targetRotation
			cancelSmoothTurn()
		end
	end)
end

local function holdFacingUntilLanding(currentHumanoid)
	releaseRotationLock()

	rotationLockHumanoid = currentHumanoid
	rotationLockAutoRotate = currentHumanoid.AutoRotate
	currentHumanoid.AutoRotate = false

	rotationLockId += 1
	local thisLockId = rotationLockId
	local state = currentHumanoid:GetState()
	local hasBeenAirborne = state == Enum.HumanoidStateType.Jumping
		or state == Enum.HumanoidStateType.Freefall

	rotationStateConnection = currentHumanoid.StateChanged:Connect(function(_, newState)
		if thisLockId ~= rotationLockId then
			return
		end

		if newState == Enum.HumanoidStateType.Jumping
			or newState == Enum.HumanoidStateType.Freefall then
			hasBeenAirborne = true
		elseif hasBeenAirborne
			and (newState == Enum.HumanoidStateType.Landed
				or newState == Enum.HumanoidStateType.Running) then
			releaseRotationLock()
		end
	end)

	-- Failsafe in case the character never reports a landing state.
	task.delay(2, function()
		if thisLockId == rotationLockId then
			releaseRotationLock()
		end
	end)
end

-- This listener stays active when the menu is hidden; only the Enabled toggle stops it.
UserInputService.JumpRequest:Connect(function()
	if not jumpRotationEnabled or not humanoid or not rootPart then
		return
	end
	if humanoid.Health <= 0 or not rootPart.Parent then
		return
	end
	if os.clock() - lastJumpTime < JUMP_COOLDOWN then
		return
	end

	local targetCFrame = getAimFacingCFrame(rootPart)
	if not targetCFrame then
		return
	end

	lastJumpTime = os.clock()
	cancelSmoothTurn()
	holdFacingUntilLanding(humanoid)
	turnToTarget(rootPart, targetCFrame)
end)


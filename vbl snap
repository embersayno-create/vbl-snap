local function destroy()
	if not alive then return end
	alive = false
	characterVersion += 1
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	cancelSmoothTurn()
	releaseRotationLock()
	Automation:Destroy()
	BallTracker:Destroy()
	screenGui:Destroy()
	if environment[sessionKey] == destroy then environment[sessionKey] = nil end
end

connect(screenGui.Destroying, destroy)
environment[sessionKey] = destroy

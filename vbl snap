		BorderSizePixel = 0,
	}, row)

	local boxStroke = make("UIStroke", {
		Color = colors.border,
		Thickness = 1,
	}, box)

	local checkMark = make("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "✓",
		TextColor3 = colors.green,
		TextSize = 14,
		Font = Enum.Font.Code,
		Visible = false,
	}, box)

	local labelObject = make("TextLabel", {
		Position = UDim2.new(0, 29, 0, 0),
		Size = UDim2.new(1, -29, 1, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = colors.muted,
		TextSize = 14,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local function refresh()
		local checked = getValue()
		checkMark.Visible = checked
		boxStroke.Color = checked and colors.green or colors.border
		labelObject.TextColor3 = checked and colors.text or colors.muted
	end

	connect(row.Activated, function()
		onChanged(not getValue())
		refresh()
	end)

	refresh()
	return { Refresh = refresh, frame = row }
end


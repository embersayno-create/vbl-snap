local function cancelKeyCapture()
	local capture = keyCapture
	keyCapture, menuKeyCapture = nil, false
	if capture then capture.binding.render() end
end

local function beginKeyCapture(binding, control)
	cancelKeyCapture()
	keyCapture = { binding = binding, control = control }
	menuKeyCapture = true
	control.Text = "Press key"
end

local function keyInUse(key, except)
	for _, binding in pairs(Bindings) do
		if binding ~= except and binding.active and binding.key == key then return true end
	end
	return false
end

local function makeKeybindRow(parent, y, text, binding)
	local row = make("Frame", {
		Position = UDim2.fromOffset(8, y), Size = UDim2.new(1, -16, 0, 32),
		BackgroundTransparency = 1,
	}, parent)
	make("TextLabel", {
		Size = UDim2.new(1, -278, 1, 0), BackgroundTransparency = 1,
		Text = text, Font = Enum.Font.Code, TextSize = 14, TextColor3 = colors.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local function control(text, x, width)
		local result = make("TextButton", {
			Position = UDim2.new(1, x, 0, 0), Size = UDim2.fromOffset(width, 30),
			BackgroundColor3 = colors.background, BorderSizePixel = 0,
			Text = text, Font = Enum.Font.Code, TextSize = 14, TextColor3 = colors.text,
			AutoButtonColor = false,
		}, row)
		make("UIStroke", { Color = colors.border, Thickness = 1 }, result)
		return result
	end
	local keyButton = control("", -270, 84)
	local unbind = control("Unbind", -176, 78)
	local rebind = control("Rebind", -88, 78)
	binding.render = function()
		keyButton.Text = binding.key.Name
		keyButton.TextColor3 = binding.active and colors.green or colors.muted
		unbind.TextColor3 = binding.active and colors.text or colors.muted
		rebind.TextColor3 = binding.active and colors.muted or colors.green
	end
	connect(keyButton.Activated, function() beginKeyCapture(binding, keyButton) end)
	connect(unbind.Activated, function()
		cancelKeyCapture()
		binding.active = false
		binding.render()
		Config:Queue()
	end)
	connect(rebind.Activated, function()
		cancelKeyCapture()
		if keyInUse(binding.key, binding) then
			beginKeyCapture(binding, keyButton)
		else
			binding.active = true
			binding.render()
			Config:Queue()
		end
	end)
	binding.render()
	return row
end


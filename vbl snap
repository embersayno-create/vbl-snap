connect(UserInputService.InputBegan, function(input, processed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if Automation.blockHeld and input.KeyCode == Enum.KeyCode.Q then return end
	if keyCapture then
		if input.KeyCode == Enum.KeyCode.Escape then
			cancelKeyCapture()
		elseif input.KeyCode ~= Enum.KeyCode.Unknown then
			local capture = keyCapture
			if keyInUse(input.KeyCode, capture.binding) then
				capture.control.Text = "Key used"
				return
			end
			capture.binding.key = input.KeyCode
			capture.binding.active = true
			cancelKeyCapture()
			Config:Queue()
		end
		return
	end
	if UserInputService:GetFocusedTextBox() then return end
	if input.KeyCode == menuToggleKey then
		setMenuOpen(not menuOpen)
		return
	end
	if processed then return end
	for _, binding in pairs(Bindings) do
		if binding.active and input.KeyCode == binding.key and binding.callback then
			binding.callback()
			return
		end
	end
end)

local dragging = false
local dragInputPosition
local windowStartPosition

connect(header.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragInputPosition = input.Position
		windowStartPosition = window.Position
	end
end)

connect(UserInputService.InputChanged, function(input)
	if activeSizeSlider then
		local drag = activeSizeSlider
		if (drag.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
			or (drag.input.UserInputType == Enum.UserInputType.Touch and input == drag.input) then
			drag.slider:UpdateAt(input.Position.X)
		end
		return
	end
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragInputPosition

		window.Position = UDim2.new(
			windowStartPosition.X.Scale,
			windowStartPosition.X.Offset + delta.X,
			windowStartPosition.Y.Scale,
			windowStartPosition.Y.Offset + delta.Y
		)
	end
end)

connect(UserInputService.InputEnded, function(input)
	if activeSizeSlider and (input == activeSizeSlider.input
		or (activeSizeSlider.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
		activeSizeSlider = nil
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
connect(UserInputService.WindowFocusReleased, function()
	activeSizeSlider = nil
	dragging = false
end)

isPointerOverMenu = function()
	if not window.Visible then return false end
	local mouse = UserInputService:GetMouseLocation()
	local inset = GuiService:GetGuiInset()
	local position, size = window.AbsolutePosition, window.AbsoluteSize
	local x, y = position.X + inset.X, position.Y + inset.Y
	return mouse.X >= x and mouse.X <= x + size.X and mouse.Y >= y and mouse.Y <= y + size.Y
end


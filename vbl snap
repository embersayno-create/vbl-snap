local function makeHitboxSlider(y, title, getValue, setValue)
	local row = make("Frame", {
		Name = title, Position = UDim2.fromOffset(8, y),
		Size = UDim2.new(1, -16, 0, 64), BackgroundTransparency = 1,
	}, hitboxPage)
	make("TextLabel", {
		Size = UDim2.new(1, -100, 0, 22), BackgroundTransparency = 1,
		Text = title, TextColor3 = colors.muted, Font = Enum.Font.Code,
		TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valueLabel = make("TextBox", {
		Name = "SizeInput",
		Position = UDim2.new(1, -92, 0, 0), Size = UDim2.fromOffset(92, 22),
		BackgroundColor3 = colors.background, BorderSizePixel = 0,
		Text = "", TextColor3 = colors.green, PlaceholderText = "0.5-50",
		Font = Enum.Font.Code, TextSize = 14, ClearTextOnFocus = false,
	}, row)
	make("UIStroke", { Color = colors.border, Thickness = 1 }, valueLabel)
	local hitArea = make("TextButton", {
		Name = "Slider", Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1,
		BorderSizePixel = 0, Text = "", AutoButtonColor = false,
	}, row)
	local track = make("Frame", {
		Position = UDim2.new(0, 0, 0.5, -3), Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = colors.border, BorderSizePixel = 0,
	}, hitArea)
	make("UICorner", { CornerRadius = UDim.new(0, 3) }, track)
	local fill = make("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = colors.green, BorderSizePixel = 0,
	}, track)
	make("UICorner", { CornerRadius = UDim.new(0, 3) }, fill)
	local thumb = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(16, 16), BackgroundColor3 = colors.green, BorderSizePixel = 0,
	}, track)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, thumb)
	local slider = { frame = row, hitArea = hitArea, track = track, valueLabel = valueLabel }
	function slider:Refresh()
		local value = getValue()
		local alpha = math.clamp((value - 0.5) / 49.5, 0, 1)
		valueLabel.Text = string.format("%.2f", value)
		fill.Size = UDim2.fromScale(alpha, 1)
		thumb.Position = UDim2.fromScale(alpha, 0.5)
	end
	function slider:UpdateAt(screenX)
		local inset = GuiService:GetGuiInset()
		local alpha = math.clamp((screenX - track.AbsolutePosition.X - inset.X) / track.AbsoluteSize.X, 0, 1)
		local value = math.round((0.5 + alpha * 49.5) * 10) / 10
		setValue(value)
		ReceiveHitboxVisual:Update()
		self:Refresh()
	end
	connect(valueLabel.FocusLost, function()
		local value = tonumber(valueLabel.Text)
		if value and value == value then
			setValue(math.round(math.clamp(value, 0.5, 50) * 100) / 100)
			ReceiveHitboxVisual:Update()
		end
		slider:Refresh()
	end)
	connect(hitArea.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeSizeSlider = { slider = slider, input = input }
			slider:UpdateAt(input.Position.X)
		end
	end)
	slider:Refresh()
	return slider
end


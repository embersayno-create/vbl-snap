local function cancelSmoothTurn()
	if smoothTurnConnection then
		smoothTurnConnection:Disconnect()
		smoothTurnConnection = nil
	end
end

local function releaseRotationLock()
	rotationLockId += 1

	if rotationStateConnection then
		rotationStateConnection:Disconnect()
		rotationStateConnection = nil
	end

	local oldHumanoid = rotationLockHumanoid
	local oldAutoRotate = rotationLockAutoRotate

	rotationLockHumanoid = nil
	rotationLockAutoRotate = nil

	if oldHumanoid and oldHumanoid.Parent and oldAutoRotate ~= nil then
		oldHumanoid.AutoRotate = oldAutoRotate
	end
end

local function bindCharacter(character)
	characterVersion += 1
	local version = characterVersion
	releaseRotationLock()
	cancelSmoothTurn()
	humanoid, rootPart = nil, nil
	local nextHumanoid = character:WaitForChild("Humanoid")
	local nextRoot = character:WaitForChild("HumanoidRootPart")
	if not alive or version ~= characterVersion or player.Character ~= character then return end
	humanoid, rootPart = nextHumanoid, nextRoot
	lastJumpTime = -math.huge
end

connect(player.CharacterAdded, bindCharacter)
connect(player.CharacterRemoving, function()
	characterVersion += 1
	cancelSmoothTurn()
	releaseRotationLock()
	humanoid, rootPart = nil, nil
end)

if player.Character then
	bindCharacter(player.Character)
end

local BallTracker = { entries = {} }

function BallTracker:Add(model)
	if not model:IsA("Model") or not model.Name:match("^CLIENT_BALL_%d+$") or self.entries[model] then return end
	local entry = { connections = {} }
	self.entries[model] = entry
	local function refresh()
		local part = model:FindFirstChild("Ball.001", true)
		if not (part and part:IsA("BasePart")) then
			part = model.PrimaryPart
			if not part then
				for _, descendant in ipairs(model:GetDescendants()) do
					if descendant:IsA("BasePart") then
						part = descendant
						break
					end
				end
			end
		end
		entry.part = part
	end
	table.insert(entry.connections, model.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then refresh() end
	end))
	table.insert(entry.connections, model.DescendantRemoving:Connect(function(descendant)
		if descendant == entry.part then
			entry.part = nil
			task.defer(function()
				if alive and self.entries[model] == entry then refresh() end
			end)
		end
	end))
	table.insert(entry.connections, model:GetPropertyChangedSignal("PrimaryPart"):Connect(refresh))
	refresh()
end

function BallTracker:Remove(model)
	local entry = self.entries[model]
	if not entry then return end
	for _, connection in ipairs(entry.connections) do connection:Disconnect() end
	self.entries[model] = nil
end

function BallTracker:Destroy()
	for model in pairs(self.entries) do self:Remove(model) end
end

connect(workspace.ChildAdded, function(model) BallTracker:Add(model) end)
connect(workspace.ChildRemoved, function(model) BallTracker:Remove(model) end)
for _, model in ipairs(workspace:GetChildren()) do BallTracker:Add(model) end

local Automation = {
	receiveEnabled = Config.values.AutoReceiveEnabled, blockEnabled = Config.values.AutoBlockEnabled,
	receiveOnce = Config.values.OneTimeReceive, blockOnce = Config.values.OneTimeBlock,
	nextReceive = 0, nextBlock = 0,
	receiveDelayMs = Config.values.ReceiveDelayMs,
	mouseHeld = false, blockHeld = false,
	receiveHalfSize = Vector3.one * (Config.values.ReceiveSize / 2),
}
local isPointerOverMenu = function() return false end

function Automation:GetInput()
	if not self.input then self.input = game:GetService("VirtualInputManager") end
	return self.input
end

function Automation:ReleaseReceive()
	if not self.mouseHeld then return end
	self:GetInput():SendMouseButtonEvent(self.mouseX, self.mouseY, 0, false, game, 0)
	self.mouseHeld = false
end

function Automation:ReleaseBlock()
	if not self.blockHeld then return end
	self:GetInput():SendKeyEvent(false, Enum.KeyCode.Q, false, game)
	self.blockHeld = false
end

function Automation:UpdateUI()
	if self.updateControls then self.updateControls() end
end

function Automation:SetReceive(enabled)
	self.receiveEnabled = enabled
	if not enabled then self:ReleaseReceive() end
	self:UpdateUI()
	Config:Queue()
end

function Automation:SetBlock(enabled)
	self.blockEnabled = enabled
	if not enabled then self:ReleaseBlock() end
	self:UpdateUI()
	Config:Queue()
end

function Automation:GetReceiveFrame()
	if not humanoid or not rootPart or humanoid.Health <= 0 then return nil end
	local head = humanoid.Parent:FindFirstChild("Head")
	return head and CFrame.new(head.Position) * rootPart.CFrame.Rotation
end

function Automation:SetReceiveSize(size)
	self.receiveHalfSize = Vector3.one * (size / 2)
	Config:Queue()
end

function Automation:InReceiveHitbox(part, boxFrame)
	local point = boxFrame:PointToObjectSpace(part.Position)
	local half = self.receiveHalfSize
	local radius = math.min(part.Size.X, part.Size.Y, part.Size.Z) * 0.5
	local dx = math.max(math.abs(point.X) - half.X, 0)
	local dy = math.max(math.abs(point.Y) - half.Y, 0)
	local dz = math.max(math.abs(point.Z) - half.Z, 0)
	return dx * dx + dy * dy + dz * dz <= radius * radius
end

function Automation:Step(now)
	if self.mouseHeld and now >= self.mouseReleaseAt then self:ReleaseReceive() end
	if self.blockHeld and now >= self.blockReleaseAt then self:ReleaseBlock() end
	if not (self.receiveEnabled or self.blockEnabled) then return end
	if not humanoid or not rootPart or humanoid.Health <= 0 then return end
	if menuKeyCapture or UserInputService:GetFocusedTextBox() then return end
	local airborne = humanoid.FloorMaterial == Enum.Material.Air
	local receiveReady = self.receiveEnabled and not airborne and not self.mouseHeld
		and now >= self.nextReceive and not isPointerOverMenu()
	local blockReady = self.blockEnabled and airborne and not self.blockHeld and now >= self.nextBlock
	if not (receiveReady or blockReady) then return end
	local receiveFrame = receiveReady and self:GetReceiveFrame()
	for _, entry in pairs(BallTracker.entries) do
		local part = entry.part
		if part then
			if receiveFrame and self:InReceiveHitbox(part, receiveFrame) then
				local mouse = UserInputService:GetMouseLocation()
				self.mouseX, self.mouseY = mouse.X, mouse.Y
				self.mouseHeld = true
				self.mouseReleaseAt, self.nextReceive = now + 1 / 60, now + self.receiveDelayMs / 1000
				self:GetInput():SendMouseButtonEvent(mouse.X, mouse.Y, 0, true, game, 0)
				if self.receiveOnce then
					self.receiveEnabled = false
					self:UpdateUI()
					Config:Queue()
				end
				return
			elseif blockReady then
				local offset = part.Position - rootPart.Position
				if offset.X * offset.X + offset.Z * offset.Z < 8.9 * 8.9 and math.abs(offset.Y) < 14.8 then
					self.blockHeld = true
					self.blockReleaseAt, self.nextBlock = now + 1 / 60, now + 0.10
					self:GetInput():SendKeyEvent(true, Enum.KeyCode.Q, false, game)
					if self.blockOnce then
						self.blockEnabled = false
						self:UpdateUI()
						Config:Queue()
					end
					return
				end
			end
		end
	end
end

function Automation:Destroy()
	self:SetReceive(false)
	self:SetBlock(false)
end


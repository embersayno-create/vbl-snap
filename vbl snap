		Visible = false,
	}, box)

	local labelObject = make("TextLabel", {
		Position = UDim2.new(0, 29, 0, 0),
		Size = UDim2.new(1, -29, 1, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = colors.muted,
		TextSize = 14,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)


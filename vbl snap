local function makeCheckbox(parent, y, label, getValue, onChanged)
	local row = make("TextButton", {
		Size = UDim2.new(1, -16, 0, 22),
		Position = UDim2.new(0, 8, 0, y),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
	}, parent)

	local box = make("Frame", {
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.new(0, 0, 0.5, -7),
		BackgroundColor3 = colors.background,
		BorderSizePixel = 0,
	}, row)
	local boxStroke = make("UIStroke", { Color = colors.border, Thickness = 1 }, box)
	make("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "✓",
		TextColor3 = colors.green,
		TextSize = 12,
		Font = Enum.Font.Code,
		Visible = false,
	}, box)

	local labelObject = make("TextLabel", {
		Position = UDim2.new(0, 23, 0, 0),
		Size = UDim2.new(1, -23, 1, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = colors.muted,
		TextSize = 12,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local checkMark = box:FindFirstChildOfClass("TextLabel")

	local function refresh()
		local checked = getValue()
		checkMark.Visible = checked
		boxStroke.Color = checked and colors.green or colors.border
		labelObject.TextColor3 = checked and colors.text or colors.muted
	end

	row.Activated:Connect(function()
		onChanged(not getValue())
		refresh()
	end)
	refresh()
	return refresh
end

